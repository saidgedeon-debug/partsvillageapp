# Required for the app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel / local .env) — operator unlock + portal + Storage
SUPABASE_SERVICE_ROLE_KEY=

# Required — shop unlock PIN (no client-side / VITE_ fallback)
OPERATOR_PIN=

# Primary operator Auth email (used for unlock sign-in)
OPERATOR_EMAIL=operator@partsvillage.local

# Optional comma-separated additional operator emails (same password/PIN).
# Each is ensured with role=operator; unlock still signs in as OPERATOR_EMAIL
# (or the first email in OPERATOR_EMAILS when OPERATOR_EMAIL is unset).
# OPERATOR_EMAILS=operator@partsvillage.local,backup@partsvillage.local

# Optional — Auth password for the operator user. If unset, a SHA-256 derived
# password is used (not the raw PIN), so direct Supabase password-grant cannot
# unlock with the shop PIN alone. Prefer setting a long unique value in Vercel.
OPERATOR_PASSWORD=

# Optional WebAuthn pins (defaults allow production host + localhost)
# WEBAUTHN_RP_ID=partsvillageapp.vercel.app
# WEBAUTHN_ORIGIN=https://partsvillageapp.vercel.app
# WEBAUTHN_ALLOWED_HOSTS=partsvillageapp.vercel.app,localhost,127.0.0.1
